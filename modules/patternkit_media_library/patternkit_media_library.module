<?php

/**
 * @file
 * Patternkit Media Library Support.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\patternkit_media_library\Hook\PatternkitMediaLibraryHooks;

/**
 * Implements hook_element_info_alter().
 */
#[LegacyHook]
function patternkit_media_library_element_info_alter(array &$info): void {
  \Drupal::classResolver(PatternkitMediaLibraryHooks::class)
    ->elementInfoAlter($info);
}
