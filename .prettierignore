# Prettier ignore patterns

# YAML configuration files
*.yml
*.yaml

# Compiled/built assets (generated by Gulp, don't reformat)
/js/*.js
!/js/patternkit.jsoneditor*.js
!/js/postcss/
/js/nonmin/

/css/*.css
!/css/cygnet/
/css/cygnet/cygnet--prefixed-for-drupal--upstream.css

# Dependencies
/node_modules/
/vendor/
/web/

# Lock files (managed by package manager)
composer.lock
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-shrinkwrap.json

# Test modules and generated files
/tests/modules/patternkit_test/lib/patternkit
/tests/fixtures/

# Distribution and build artifacts
dist/
build/
*.min.js
*.min.css

# Ticket documentation and local dev notes (not production content)
/docs/

# AI tooling and worktree directories (host-side only; not reachable from container)
/.claude/
/.cursor/
/.worktrees/
