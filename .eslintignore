# Dependencies (generated by Composer/npm)
/node_modules/
/vendor/
/web/

# Build tooling scripts — node_modules unavailable in CI causes import/no-unresolved false-positives
**/gulpfile.js

# Compiled/built assets (generated by Gulp, don't lint)
/js/*.js
/js/nonmin/*

# Symlink to modules/patternkit_example/lib/patternkit; excluded to avoid double-linting
/tests/modules/patternkit_test/lib/patternkit

# Build artifacts written here by PHPUnit coverage, Playwright, and other tooling
/artifacts/

# Ticket documentation and reproduction scripts — not production JS
/docs/

# Example pattern library with its own independent build toolchain (node-sass, Parcel,
# Gulp) and atom scaffolding that predates current JS standards. Excluded pending
# modernization of the patternkit_example module.
/modules/patternkit_example/lib/patternkit/
