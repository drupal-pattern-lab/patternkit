<?php

/**
 * @file
 * Patternkit parses pattern libraries and ingests them into Drupal Blocks.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\patternkit\Hook\PatternkitBlockEntityHooks;
use Drupal\patternkit\Hook\PatternkitHooks;
use Drupal\patternkit\Hook\ReusableBlockHooks;
use Drupal\patternkit\Hook\ThemeHooks;
use Drupal\patternkit\Hook\ValidityStampCronHooks;
use Drupal\patternkit\Hook\ValidityStampEntityHooks;

/**
 * Implements hook_help().
 *
 * @see \Drupal\patternkit\Hook\PatternkitHooks::help()
 */
#[LegacyHook]
function patternkit_help($route_name, RouteMatchInterface $route_match): ?TranslatableMarkup {
  /** @var \Drupal\patternkit\Hook\PatternkitHooks $patternkit_hooks */
  $patternkit_hooks = \Drupal::classResolver(PatternkitHooks::class);
  return $patternkit_hooks->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 *
 * @see \Drupal\patternkit\Hook\PatternkitHooks::theme()
 */
#[LegacyHook]
function patternkit_theme($existing, $type, $theme, $path): array {
  /** @var \Drupal\patternkit\Hook\PatternkitHooks $patternkit_hooks */
  $patternkit_hooks = \Drupal::classResolver(PatternkitHooks::class);
  return $patternkit_hooks->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_entity_presave().
 *
 * @see \Drupal\patternkit\Hook\PatternkitBlockEntityHooks::handlePreSave()
 */
#[LegacyHook]
function patternkit_entity_presave(EntityInterface $entity): void {
  /** @var \Drupal\patternkit\Hook\PatternkitBlockEntityHooks $entity_hooks */
  $entity_hooks = \Drupal::classResolver(PatternkitBlockEntityHooks::class);
  $entity_hooks->handlePreSave($entity);
}

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function patternkit_entity_type_alter(array &$entity_types): void {
  /** @var \Drupal\patternkit\Hook\ReusableBlockHooks $reusable_block_hooks */
  $reusable_block_hooks = \Drupal::classResolver(ReusableBlockHooks::class);
  $reusable_block_hooks->entityTypeAlter($entity_types);
}

/**
 * Implements hook_entity_insert().
 *
 * @see \Drupal\patternkit\Hook\PatternkitBlockEntityHooks::handlePostSave()
 */
#[LegacyHook]
function patternkit_entity_insert(EntityInterface $entity): void {
  /** @var \Drupal\patternkit\Hook\PatternkitBlockEntityHooks $entity_hooks */
  $entity_hooks = \Drupal::classResolver(PatternkitBlockEntityHooks::class);
  $entity_hooks->handlePostSave($entity);
}

/**
 * Implements hook_entity_update().
 *
 * @see \Drupal\patternkit\Hook\PatternkitBlockEntityHooks::handlePostSave()
 */
#[LegacyHook]
function patternkit_entity_update(EntityInterface $entity): void {
  /** @var \Drupal\patternkit\Hook\PatternkitBlockEntityHooks $entity_hooks */
  $entity_hooks = \Drupal::classResolver(PatternkitBlockEntityHooks::class);
  $entity_hooks->handlePostSave($entity);
}

/**
 * Implements hook_entity_predelete().
 *
 * @see \Drupal\patternkit\Hook\PatternkitBlockEntityHooks::handlePreDelete()
 */
#[LegacyHook]
function patternkit_entity_predelete(EntityInterface $entity): void {
  /** @var \Drupal\patternkit\Hook\PatternkitBlockEntityHooks $entity_hooks */
  $entity_hooks = \Drupal::classResolver(PatternkitBlockEntityHooks::class);
  $entity_hooks->handlePreDelete($entity);
}

/**
 * Implements hook_contextual_links_alter().
 */
#[LegacyHook]
function patternkit_contextual_links_alter(array &$links, $group, array $route_parameters): void {
  /** @var \Drupal\patternkit\Hook\ReusableBlockHooks $reusable_block_hooks */
  $reusable_block_hooks = \Drupal::classResolver(ReusableBlockHooks::class);
  $reusable_block_hooks->contextualLinksAlter($links, $group, $route_parameters);

  /** @var \Drupal\patternkit\Hook\ThemeHooks $theme_hooks */
  $theme_hooks = \Drupal::classResolver(ThemeHooks::class);
  $theme_hooks->contextualLinksAlter($links, $group, $route_parameters);
}

/**
 * Implements hook_local_tasks_alter().
 */
#[LegacyHook]
function patternkit_local_tasks_alter(&$local_tasks): void {
  /** @var \Drupal\patternkit\Hook\ReusableBlockHooks $reusable_block_hooks */
  $reusable_block_hooks = \Drupal::classResolver(ReusableBlockHooks::class);
  $reusable_block_hooks->localTasksAlter($local_tasks);
}

/**
 * Implements hook_menu_local_actions_alter().
 */
#[LegacyHook]
function patternkit_menu_local_actions_alter(&$local_actions): void {
  /** @var \Drupal\patternkit\Hook\ReusableBlockHooks $reusable_block_hooks */
  $reusable_block_hooks = \Drupal::classResolver(ReusableBlockHooks::class);
  $reusable_block_hooks->menuLocalActionsAlter($local_actions);
}

/**
 * Implements hook_link_alter().
 */
#[LegacyHook]
function patternkit_link_alter(&$variables): void {
  /** @var \Drupal\patternkit\Hook\ThemeHooks $theme_hooks */
  $theme_hooks = \Drupal::classResolver(ThemeHooks::class);
  $theme_hooks->linkAlter($variables);
}

/**
 * Implements hook_entity_delete().
 *
 * @see \Drupal\patternkit\Hook\ValidityStampEntityHooks::entityDelete()
 */
#[LegacyHook]
function patternkit_entity_delete(EntityInterface $entity): void {
  /** @var \Drupal\patternkit\Hook\ValidityStampEntityHooks $stamp_hooks */
  $stamp_hooks = \Drupal::classResolver(ValidityStampEntityHooks::class);
  $stamp_hooks->entityDelete($entity);
}

/**
 * Implements hook_entity_translation_delete().
 *
 * @see \Drupal\patternkit\Hook\ValidityStampEntityHooks::entityTranslationDelete()
 */
#[LegacyHook]
function patternkit_entity_translation_delete(EntityInterface $entity): void {
  /** @var \Drupal\patternkit\Hook\ValidityStampEntityHooks $stamp_hooks */
  $stamp_hooks = \Drupal::classResolver(ValidityStampEntityHooks::class);
  $stamp_hooks->entityTranslationDelete($entity);
