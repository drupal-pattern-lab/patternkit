/**
 * Implements hook_cron().
 *
 * @see \Drupal\patternkit\Hook\ValidityStampCronHooks::cron()
 */
#[LegacyHook]
function patternkit_cron(): void {
  /** @var \Drupal\patternkit\Hook\ValidityStampCronHooks $cron_hooks */
  $cron_hooks = \Drupal::classResolver(ValidityStampCronHooks::class);
  $cron_hooks->cron();
}

/**
 * Implements hook_rebuild().
 */
function patternkit_rebuild(): void {
  // Rebuild the library definitions cache.
  \Drupal::service('patternkit.library.namespace_resolver')
    ->rebuild();

  // Rebuild the pattern discovery cache.
  \Drupal::service('patternkit.pattern.discovery')
    ->rebuild();
}
